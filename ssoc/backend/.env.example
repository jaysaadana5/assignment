# Backend environment variables for the SSOC site.
# Copy this file to `.env` and adjust as needed.

# MongoDB connection string.
#  - Local docker-compose: mongodb://mongo:27017
#  - Local standalone mongod: mongodb://localhost:27017
MONGO_URL=mongodb://localhost:27017

# Name of the MongoDB database to use.
DB_NAME=ssoc

# Serve the static frontend (frontend/public) from this same server so the site
# and its /api backend share one origin. Set to "false" if an external proxy or
# CDN serves the frontend separately.
SERVE_STATIC=true

# Optional: override the static frontend directory (defaults to ../frontend/public).
# STATIC_DIR=/app/frontend/public
